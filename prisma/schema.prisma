datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String                @id @default(uuid())
  email         String                @unique
  password      String
  businessName  String
  phone         String?
  role          String                @default("CUSTOMER") // "ADMIN" or "CUSTOMER"
  status        String                @default("APPROVED") // "APPROVED", "PENDING", "REJECTED"
  
  // WhatsApp Cloud API Credentials
  wabaId        String?
  phoneNumberId String?
  accessToken   String?
  
  createdAt     DateTime              @default(now())
  campaigns     Campaign[]
  subscriptions ProductSubscription[]
  website       Website?
  invoices      Invoice[]
  crmContacts   CrmContact[]
}

model Website {
  id              String            @id @default(uuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String            @unique
  businessName    String
  tagline         String?
  headline        String?
  about           String?
  phone           String?
  whatsapp        String?
  address         String?
  hours           String?
  theme           String            @default("blue")
  logo            String?
  servicesJson    String            @default("[]")
  galleryJson     String            @default("[]")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  serviceRequests ServiceRequest[]
  analyticsEvents AnalyticsEvent[]
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  websiteId String
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  eventType String   // 'PAGE_VIEW', 'CALL_CLICK', 'WHATSAPP_CLICK', 'MAP_CLICK', 'VCARD_DOWNLOAD'
  createdAt DateTime @default(now())
}

model ServiceRequest {
  id          String    @id @default(uuid())
  websiteId   String
  website     Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  vehicle     String?
  service     String?
  notes       String?
  status      String    @default("NEW") // "NEW", "IN_PROGRESS", "COMPLETED"
  createdAt   DateTime  @default(now())
}

model ProductSubscription {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productKey  String    // e.g. "WHATSAPP_BROADCAST", "WEBSITE_BUILDER", "AI_CHATBOT"
  status      String    @default("ACTIVE") // "ACTIVE", "EXPIRED"
  createdAt   DateTime  @default(now())

  @@unique([userId, productKey])
}

model Campaign {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  templateName String          @default("general_broadcast")
  languageCode String          @default("en_US")
  createdAt    DateTime        @default(now())
  messages     MessageRecord[]
}

model MessageRecord {
  id           String    @id @default(uuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phoneNumber  String
  wamid        String?   @unique
  status       String    @default("PENDING") // PENDING, SENT, DELIVERED, READ, FAILED
  errorMessage String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Invoice {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNumber    String
  customerName     String
  customerPhone    String
  customerEmail    String?
  customerAddress  String?
  businessCategory String    @default("GENERAL") // AUTOMOTIVE, SALON_SPA, CLINIC, RETAIL, FREELANCE, GENERAL
  referenceNo      String?   // Vehicle No (TN 10 AB 1234), Patient ID, or Project Name
  itemsJson        String    @default("[]") // [{ name, qty, rate, amount }]
  subtotal         Float     @default(0)
  taxPercent       Float     @default(0)
  taxAmount        Float     @default(0)
  discount         Float     @default(0)
  totalAmount      Float     @default(0)
  status           String    @default("PENDING") // PAID, PENDING, CANCELLED
  paymentMethod    String?   // UPI, CASH, CARD, NET_BANKING
  upiId            String?   // Merchant UPI ID for QR generation
  notes            String?
  dueDate          DateTime?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model CrmContact {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  phone            String
  email            String?
  category         String    @default("GENERAL") // AUTOMOTIVE, SALON_SPA, CLINIC, GYM_FITNESS, RETAIL, GENERAL
  referenceNo      String?   // Vehicle No, Patient ID, Member ID
  reminderType     String    @default("SERVICE_DUE") // SERVICE_DUE, INSURANCE_DUE, APPOINTMENT, MEMBERSHIP_DUE, CHECKUP, CUSTOM
  reminderTitle    String?
  lastInteraction  DateTime?
  nextDueDate      DateTime?
  repeatCycleDays  Int       @default(90) // 30, 60, 90, 180, 365
  status           String    @default("ACTIVE") // ACTIVE, OVERDUE, FOLLOWED_UP, COMPLETED
  notes            String?
  totalVisits      Int       @default(1)
  totalSpend       Float     @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
